{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for WhatsApp Desktop",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "opener:default",
    "dialog:default",
    "autostart:default",
    "allow-open-download-dir",
    "allow-open-external-url",
    "allow-save-downloaded-file",
    "allow-send-notification",
    "allow-toggle-always-on-top",
    "allow-update-dock-badge"
  ],
  "remote": {
    "urls": [
      "https://web.whatsapp.com/*"
    ]
  }
}
